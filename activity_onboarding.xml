<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fitsSystemWindows="true"
    tools:ignore="HardcodedText,ContentDescription,TouchTargetSizeCheck">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Step Progress Indicator Bar -->
            <LinearLayout
                android:id="@+id/onboardingHeaderLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent">

                <ImageButton
                    android:id="@+id/btnOnboardingBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_white_button"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/text_primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:id="@+id/tvStepIndicator"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="STEP 1 OF 5"
                        android:textColor="@color/primary"
                        android:textSize="11sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvStepTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Who is this profile for?"
                        android:textColor="@color/text_primary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                </LinearLayout>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/onboardingProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:progress="20"
                android:progressTint="@color/primary"
                android:progressBackgroundTint="@color/border"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@id/onboardingHeaderLayout"/>

            <!-- Steps Dynamic Container -->
            <FrameLayout
                android:id="@+id/stepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/onboardingProgressBar">

                <!-- ================= STEP 1: WHO IS PROFILE FOR? ================= -->
                <LinearLayout
                    android:id="@+id/step1Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Profile Type"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Medical information entered will be strictly isolated under this profile."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>

                <!-- Options -->
                <RadioGroup
                    android:id="@+id/rgOwnerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp">

                    <RadioButton
                        android:id="@+id/rbMyself"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Myself (Personal Emergency Profile)"
                        android:textSize="14sp"
                        android:padding="12dp"
                        android:checked="true"/>

                    <RadioButton
                        android:id="@+id/rbFamily"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Family Member (Parent, Child, Spouse)"
                        android:textSize="14sp"
                        android:padding="12dp"/>

                    <RadioButton
                        android:id="@+id/rbFriend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Friend / Caregiver Ward"
                        android:textSize="14sp"
                        android:padding="12dp"/>
                </RadioGroup>

                <!-- Target Relationship (if family selected) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRelationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Relationship (e.g. Father, Mother, Child)"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    android:visibility="gone"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRelationship"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Father"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

                <!-- ================= STEP 2: PERSONAL HEALTH DETAILS ================= -->
                <LinearLayout
                    android:id="@+id/step2Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilStep2Name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Patient Legal Name"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etStep2Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Aarav Patel"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStep2Dob"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Date of Birth"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStep2Dob"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="1994-06-18"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStep2Blood"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Blood Group"
                        android:layout_marginStart="10dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStep2Blood"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="O+"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStep2Gender"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Gender"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStep2Gender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Male"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilStep2Donor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Organ Donor"
                        android:layout_marginStart="10dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStep2Donor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Registered Donor"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

                <!-- ================= STEP 3: EMERGENCY CONTACTS ================= -->
                <LinearLayout
                    android:id="@+id/step3Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary Emergency Contact"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilContactName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Contact Full Name"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etContactName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kavita Patel"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContactRelation"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Relationship"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContactRelation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Mother"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilContactPhone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Mobile Number"
                        android:layout_marginStart="10dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etContactPhone"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="phone"
                            android:text="+91 98250 11223"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbShowOnQr"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Display contact directly on Emergency 3D Card QR triage"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:checked="true"
                    android:layout_marginTop="10dp"/>
            </LinearLayout>

                <!-- ================= STEP 4: MEDICAL HISTORY ================= -->
                <LinearLayout
                    android:id="@+id/step4Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Primary Medical Condition"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilCondName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Condition / Diagnosis"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCondName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Acute Myocardial Infarction (Heart Attack)"/>
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCondHospital"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Hospital / Clinic"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCondHospital"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Sunrise Multispeciality Hospital"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilCondDoctor"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Treating Doctor"
                        android:layout_marginStart="10dp"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCondDoctor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Dr. Rahul Shah"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Critical Life-Threatening Allergy"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAllergyName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Allergen Name"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAllergyName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Penicillin"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilAllergyReaction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Reaction (e.g. Severe Anaphylaxis)"
                    android:layout_marginTop="10dp"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAllergyReaction"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Severe Anaphylactic Shock &amp; Bronchospasm"/>
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

                <!-- ================= STEP 5: FINAL VERIFICATION ================= -->
                <LinearLayout
                    android:id="@+id/step5Layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Generated Medical Profile ID"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvFinalProfileId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MED-8924-7193"
                    android:textColor="@color/primary_dark"
                    android:textSize="22sp"
                    android:fontFamily="monospace"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <!-- Summary Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card_rounded"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginTop="14dp">

                    <TextView
                        android:id="@+id/tvFinalSummaryName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Patient: Aarav Patel (32 yrs, Male)"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvFinalSummaryBlood"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Blood Group: O+ • Registered Organ Donor"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvFinalSummaryContact"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Primary Contact: Kavita Patel (+91 98250 11223)"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="4dp"/>

                    <TextView
                        android:id="@+id/tvFinalSummaryAllergy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Critical Allergy: Penicillin"
                        android:textColor="@color/emergency_red"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cbFinalConsent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="I confirm that all entered clinical details are accurate and authorize emergency first-responder triage access."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:checked="true"
                    android:layout_marginTop="14dp"/>
            </LinearLayout>

            </FrameLayout>

            <!-- Bottom Wizard Navigation Buttons -->
            <LinearLayout
                android:id="@+id/wizardActionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/stepsContainer">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWizardBack"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="Previous"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/white"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp"
                    android:visibility="gone"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWizardNext"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="2"
                    android:text="Next Step"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@id/wizardActionsLayout"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
