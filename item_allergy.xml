<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvAllergyName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Penicillin"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvAllergySeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRITICAL / LIFE THREATENING"
                android:background="@drawable/bg_badge_red"
                android:textColor="@color/emergency_red"
                android:textSize="10sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAllergyReaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reaction: Severe Anaphylactic Shock &amp; Bronchospasm"
            android:textColor="@color/emergency_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tvAllergyTreatment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Protocol: Emergency Epinephrine / Strictly Avoid Beta-Lactams"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <!-- Action Buttons (Edit, Delete) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnEditAllergy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Edit"
                android:textColor="@color/primary"
                android:textSize="11sp"/>

            <Button
                android:id="@+id/btnDeleteAllergy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Delete"
                android:textColor="@color/emergency_red"
                android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
