<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_rounded">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvConditionDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Medical Condition Questionnaire"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Record clinical details, surgical interventions, and treating facility."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <!-- Condition Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCondDialogName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Condition Name (e.g. Heart Attack, Asthma)"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            android:layout_marginTop="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCondDialogName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Category & Diagnosed Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCondDialogCategory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Category"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCondDialogCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cardiovascular"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCondDialogDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Date / Year"
                android:layout_marginStart="10dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCondDialogDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2024-03-14"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Hospital & Doctor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCondDialogHospital"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Hospital / Facility"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCondDialogHospital"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sunrise Multispeciality Hospital"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCondDialogDoctor"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Treating Doctor"
                android:layout_marginStart="10dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCondDialogDoctor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Dr. Rahul Shah"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Treatment Received -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCondDialogTreatment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Treatment (e.g. Angioplasty, Stent, Medication)"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCondDialogTreatment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Angioplasty + 1 Drug-Eluting Stent"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Stents & Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCondDialogStents"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Number of Stents"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCondDialogStents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCondDialogStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Current Status"
                android:layout_marginStart="10dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCondDialogStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Currently taking medication"/>
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Emergency Relevant Checkbox -->
        <CheckBox
            android:id="@+id/cbEmergencyRelevant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚨 Include in Emergency Triage Pass (Critical for First Responders)"
            android:textColor="@color/emergency_red"
            android:textSize="12sp"
            android:textStyle="bold"
            android:checked="true"
            android:layout_marginTop="10dp"/>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCondDialogNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Clinical Notes / Findings"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            android:layout_marginTop="8dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCondDialogNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Single drug-eluting stent in proximal LAD. Under quarterly cardiology follow-up."/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="18dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCondDialog"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Cancel"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/white"
                app:strokeColor="@color/border"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveCondDialog"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Save Record"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="12dp"
                android:layout_marginStart="10dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
