<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/warning_amber_border"
    app:cardBackgroundColor="@color/warning_amber_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_alert_triangle"
                app:tint="@color/warning_amber"/>

            <TextView
                android:id="@+id/tvAccessRequesterTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Full Medical Access Request"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"/>

            <TextView
                android:id="@+id/tvAccessStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PENDING"
                android:textColor="@color/warning_amber"
                android:textSize="10sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAccessRequesterName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dr. Priyanka Nair • Apollo Emergency Triage"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp"/>

        <TextView
            android:id="@+id/tvAccessReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reason: Evaluating acute chest pain &amp; past stent history"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:id="@+id/tvAccessDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Requested Session Duration: 30 minutes"
            android:textColor="@color/primary_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp"/>

        <!-- Action Buttons: Approve (30m/120m), Reject -->
        <LinearLayout
            android:id="@+id/layoutAccessButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnRejectAccess"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Reject"
                android:textColor="@color/emergency_red"
                android:textSize="11sp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveAccess"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:text="Approve Access"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="10dp"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
