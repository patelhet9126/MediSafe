<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/border"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivFamilyAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_badge_green"
                android:padding="8dp"
                android:src="@drawable/ic_profile"
                app:tint="@color/primary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvFamilyName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kavita Patel"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:id="@+id/tvFamilyRelation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MOTHER"
                        android:background="@drawable/bg_badge_green"
                        android:textColor="@color/primary_dark"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp"
                        android:layout_marginStart="8dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvFamilyMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Age: 58 • Blood: B+ • Active Card"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvFamilyCompletion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="90%"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvFamilyCondition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Primary Condition: Type 2 Diabetes (Metformin)"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:layout_marginTop="8dp"/>

        <!-- Switch to Profile button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSwitchToProfile"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Switch To This Profile"
            android:textColor="@color/primary_dark"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="@color/primary_tint"
            app:strokeColor="@color/primary_light"
            app:strokeWidth="1dp"
            app:cornerRadius="10dp"
            android:layout_marginTop="10dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
