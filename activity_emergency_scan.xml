<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    tools:ignore="HardcodedText,ContentDescription,TouchTargetSizeCheck">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Top Header Navigation -->
        <ImageButton
            android:id="@+id/btnExitScan"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_white_button"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/text_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <TextView
            android:id="@+id/tvScanHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="First-Responder Triage"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginStart="12dp"
            app:layout_constraintTop_toTopOf="@id/btnExitScan"
            app:layout_constraintBottom_toBottomOf="@id/btnExitScan"
            app:layout_constraintStart_toEndOf="@id/btnExitScan"/>

        <TextView
            android:id="@+id/tvScanTokenLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TOKEN #O9X84A"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="@id/btnExitScan"
            app:layout_constraintBottom_toBottomOf="@id/btnExitScan"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- QR Scanner Simulator Bar -->
        <LinearLayout
            android:id="@+id/qrSimulatorLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_white_button"
            android:padding="6dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnExitScan">

            <EditText
                android:id="@+id/etScannedTokenInput"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hint="Scan or Enter Token / Profile ID"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:background="@android:color/transparent"
                android:paddingHorizontal="10dp"
                android:text="MED-8924-7193"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRunScanValidate"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Decode QR"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="@color/primary"
                app:cornerRadius="10dp"/>
        </LinearLayout>

        <!-- Main High-Impact Emergency Triage Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvEmergencyTriageCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/qrSimulatorLayout">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Red Emergency Banner -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/emergency_red"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🚨  EMERGENCY MEDICAL INFORMATION"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="First-Responder Triaging Pass • Critical Care Information Only"
                        android:textColor="#FFE4E6"
                        android:textSize="10sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Patient Demographics -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivTriageAvatar"
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:background="@drawable/bg_badge_green"
                            android:padding="12dp"
                            android:src="@drawable/ic_profile"
                            app:tint="@color/primary"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="14dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PATIENT"
                                android:textColor="@color/text_secondary"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvTriagePatientName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aarav Patel"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvTriagePatientDetails"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Age: 32 • Gender: Male"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp"
                                android:layout_marginTop="2dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✓ Verified Patient ID"
                                android:textColor="@color/primary_dark"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Blood Group & Critical Allergy Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp">

                        <!-- Blood Group Box -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_badge_red"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BLOOD GROUP"
                                android:textColor="@color/emergency_red"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvTriageBloodGroup"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="O+"
                                android:textColor="@color/emergency_red"
                                android:textSize="24sp"
                                android:fontFamily="monospace"
                                android:textStyle="bold"
                                android:layout_marginTop="2dp"/>
                        </LinearLayout>

                        <!-- Critical Allergy Box -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_badge_amber"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="12dp"
                            android:layout_marginStart="10dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CRITICAL ALLERGY"
                                android:textColor="@color/warning_amber"
                                android:textSize="10sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:id="@+id/tvTriageAllergyName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Penicillin"
                                android:textColor="@color/warning_amber"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:layout_marginTop="4dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="LIFE THREATENING"
                                android:textColor="@color/warning_amber"
                                android:textSize="9sp"
                                android:textStyle="bold"/>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Severe Contraindication Warning Box -->
                    <LinearLayout
                        android:id="@+id/layoutTriageContraindication"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#BE123C"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️ SEVERE CONTRAINDICATION WARNING"
                            android:textColor="#FDE68A"
                            android:textSize="11sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvTriageContraindicationText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Patient experiences severe anaphylaxis to Penicillin. DO NOT administer beta-lactams or related derivatives."
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.2"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Emergency Relevant Condition -->
                    <LinearLayout
                        android:id="@+id/layoutTriageCondition"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_card_rounded"
                        android:orientation="vertical"
                        android:padding="12dp"
                        android:layout_marginTop="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="EMERGENCY RELEVANT CONDITION"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvTriageConditionTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Acute Myocardial Infarction (March 2024)"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tvTriageConditionNotes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Active Drug-Eluting Stent in LAD. Patient is on regular daily antiplatelet therapy (Aspirin + Ticagrelor)."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp"/>
                    </LinearLayout>

                    <!-- Primary Emergency Contact Action Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge_green"
                        android:orientation="vertical"
                        android:padding="14dp"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PRIMARY EMERGENCY CONTACT"
                            android:textColor="@color/primary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:id="@+id/tvTriageContactName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kavita Patel (Mother)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginTop="2dp"/>

                        <TextView
                            android:id="@+id/tvTriageContactPhone"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="+91 98250 11223"
                            android:textColor="@color/text_secondary"
                            android:textSize="13sp"
                            android:fontFamily="monospace"
                            android:textStyle="bold"
                            android:layout_marginTop="1dp"/>

                        <!-- Call Emergency Contact Now Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTriageCallContact"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="Call Emergency Contact Now"
                            android:textColor="@color/white"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/primary"
                            app:cornerRadius="12dp"
                            android:layout_marginTop="10dp"
                            app:icon="@drawable/ic_phone"
                            app:iconGravity="textStart"/>
                    </LinearLayout>

                    <!-- Protected Full Records Notice -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/background"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="16dp"
                        android:layout_marginTop="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🔒 Full Medical Records Are Protected"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Scans, hospital discharge summaries, and prescriptions are not exposed on public QR scan. Verified clinicians can request time-limited authorization."
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:gravity="center"
                            android:lineSpacingMultiplier="1.2"
                            android:layout_marginTop="4dp"/>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTriageRequestAccess"
                            android:layout_width="match_parent"
                            android:layout_height="46dp"
                            android:text="Request Full Medical Access"
                            android:textColor="@color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:backgroundTint="@color/text_primary"
                            app:cornerRadius="12dp"
                            android:layout_marginTop="12dp"/>
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MediSafe Secure Health ID • ISO/IEC 18004 Compliant Token"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cvEmergencyTriageCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="40dp"
            app:layout_constraintTop_toBottomOf="@id/cvEmergencyTriageCard"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
