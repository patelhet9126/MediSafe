<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:ignore="HardcodedText,ContentDescription,TouchTargetSizeCheck">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- App Bar / Brand Header -->
            <LinearLayout
                android:id="@+id/headerBrandLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_green"
                    android:padding="6dp"
                    android:src="@drawable/ic_shield_check"
                    app:tint="@color/primary"/>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="10dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="MediSafe"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3D ID"
                            android:background="@drawable/bg_badge_green"
                            android:textColor="@color/primary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="6dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Emergency Health Identity"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Compliance Badge -->
            <TextView
                android:id="@+id/tvComplianceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️  ISO/IEC 18004 SECURE MEDICAL IDENTITY"
                android:background="@drawable/bg_badge_green"
                android:textColor="@color/primary_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/headerBrandLayout"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Main Hero Headline -->
            <TextView
                android:id="@+id/tvHeroTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Critical Medical Pass When Every Second Counts"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginTop="14dp"
                app:layout_constraintTop_toBottomOf="@id/tvComplianceBadge"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvHeroSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Instant access to blood group, cardiac history, and life-threatening allergies for first responders via interactive 3D Physical ID &amp; Safe QR."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeroTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Action Buttons Row -->
            <LinearLayout
                android:id="@+id/heroActionsLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/tvHeroSubtitle">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGetStarted"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="Fill Details / Register"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/primary"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_edit"
                    app:iconGravity="textStart"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenDashboard"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Patient Dashboard"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_dark"
                    android:backgroundTint="@color/primary_tint"
                    app:strokeColor="@color/primary_light"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp"
                    android:layout_marginTop="8dp"
                    app:icon="@drawable/ic_dashboard"
                    app:iconTint="@color/primary_dark"
                    app:iconGravity="textStart"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSimulateScan"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="Simulate Emergency QR Scan"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:backgroundTint="@color/white"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp"
                    app:cornerRadius="14dp"
                    android:layout_marginTop="8dp"
                    app:icon="@drawable/ic_qr_code"
                    app:iconTint="@color/primary"
                    app:iconGravity="textStart"/>
            </LinearLayout>

            <!-- 3D Card Interactive Preview Section -->
            <TextView
                android:id="@+id/tvPreviewHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interactive 3D Emergency Card"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/heroActionsLayout"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/tvPreviewHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to flip between Front and Back sides"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                app:layout_constraintTop_toBottomOf="@id/tvPreviewHeader"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- 3D Card Container -->
            <FrameLayout
                android:id="@+id/cardFlipContainer"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvPreviewHint">

                <!-- CARD FRONT -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardFrontView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_navy"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/ivCardLogo"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="@drawable/bg_badge_green"
                        android:padding="4dp"
                        android:src="@drawable/ic_shield_check"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:id="@+id/tvCardBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="MEDISAFE EMERGENCY ID"
                        android:textColor="#22D3EE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:layout_marginStart="8dp"
                        app:layout_constraintTop_toTopOf="@id/ivCardLogo"
                        app:layout_constraintStart_toEndOf="@id/ivCardLogo"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Secure Medical Token"
                        android:textColor="#94A3B8"
                        android:textSize="10sp"
                        app:layout_constraintTop_toBottomOf="@id/tvCardBrand"
                        app:layout_constraintStart_toStartOf="@id/tvCardBrand"/>

                    <!-- Verified Hologram Pill -->
                    <TextView
                        android:id="@+id/tvCardVerified"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✨ VERIFIED ID"
                        android:textColor="#86EFAC"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_badge_green"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="3dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Patient Info & Blood Group -->
                    <TextView
                        android:id="@+id/tvCardPatientName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Aarav Patel"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginTop="16dp"
                        app:layout_constraintTop_toBottomOf="@id/ivCardLogo"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/ivCardQrCode"/>

                    <TextView
                        android:id="@+id/tvCardPatientDetails"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Age: 32 • Male"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCardPatientName"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <LinearLayout
                        android:id="@+id/cardBadgesLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCardPatientDetails"
                        app:layout_constraintStart_toStartOf="parent">

                        <TextView
                            android:id="@+id/tvCardBloodGroup"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🩸 BLOOD: O+"
                            android:background="@drawable/bg_badge_red"
                            android:textColor="@color/emergency_red"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"/>

                        <TextView
                            android:id="@+id/tvCardDonor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🫀 ORGAN DONOR"
                            android:background="@drawable/bg_badge_green"
                            android:textColor="@color/primary_dark"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- QR Code Bitmap View -->
                    <ImageView
                        android:id="@+id/ivCardQrCode"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@color/white"
                        android:padding="4dp"
                        app:layout_constraintTop_toBottomOf="@id/tvCardVerified"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/cardAllergyBanner"/>

                    <!-- Critical Allergy Banner -->
                    <LinearLayout
                        android:id="@+id/cardAllergyBanner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#BE123C"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:layout_marginBottom="6dp"
                        app:layout_constraintBottom_toTopOf="@id/cardBottomRow">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_alert_triangle"
                            app:tint="#FDE68A"/>

                        <TextView
                            android:id="@+id/tvCardAllergyText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="CRITICAL ALLERGY: PENICILLIN"
                            android:textColor="@color/white"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            android:layout_marginStart="6dp"/>
                    </LinearLayout>

                    <!-- Bottom Bar: Emergency Contact & Token -->
                    <LinearLayout
                        android:id="@+id/cardBottomRow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <TextView
                            android:id="@+id/tvCardContact"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mother: +91 98250 11223"
                            android:textColor="#94A3B8"
                            android:textSize="10sp"/>

                        <TextView
                            android:id="@+id/tvCardTokenHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TOKEN: #O9X84A"
                            android:textColor="#38BDF8"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- CARD BACK -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cardBackView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_card_navy"
                    android:visibility="gone"
                    android:padding="16dp">

                    <!-- Magnetic Stripe -->
                    <View
                        android:id="@+id/viewMagStripe"
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_mag_stripe"
                        app:layout_constraintTop_toTopOf="parent"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="INSTRUCTIONS FOR FIRST RESPONDERS"
                        android:textColor="#22D3EE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginTop="10dp"
                        app:layout_constraintTop_toBottomOf="@id/viewMagStripe"
                        app:layout_constraintStart_toStartOf="parent"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Scan QR code on front for rapid emergency triage. Full medical history and clinical documents require time-limited patient consent."
                        android:textColor="#CBD5E1"
                        android:textSize="10sp"
                        android:lineSpacingMultiplier="1.2"
                        android:layout_marginTop="28dp"
                        app:layout_constraintTop_toBottomOf="@id/viewMagStripe"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>

                    <!-- Signature Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@color/white"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="8dp"
                        android:layout_marginBottom="8dp"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="AUTHORIZED SIGNATURE"
                                android:textColor="@color/text_secondary"
                                android:textSize="8sp"
                                android:textStyle="bold"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Aarav Patel"
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvBackEncryptedId"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ID: MED-8924-7193"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>

            </FrameLayout>

            <!-- Flip Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFlipCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Flip Card 3D"
                android:textSize="12sp"
                android:textColor="@color/primary_dark"
                android:backgroundTint="@color/primary_tint"
                app:strokeColor="@color/primary_light"
                app:strokeWidth="1dp"
                app:cornerRadius="10dp"
                android:layout_marginTop="10dp"
                app:icon="@drawable/ic_rotate"
                app:iconTint="@color/primary_dark"
                app:layout_constraintTop_toBottomOf="@id/cardFlipContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <!-- Feature Columns -->
            <TextView
                android:id="@+id/tvFeaturesHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Core Health Pass Features"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="28dp"
                app:layout_constraintTop_toBottomOf="@id/btnFlipCard"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Feature 1: Safe QR -->
            <LinearLayout
                android:id="@+id/featureSafeQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/tvFeaturesHeader">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_qr_code"
                    app:tint="@color/primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Zero-Knowledge QR Triage"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Only blood group, critical allergies, and emergency contacts are revealed on QR scan. Sensitive lab reports remain encrypted."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Feature 2: Family Circle -->
            <LinearLayout
                android:id="@+id/featureFamily"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:orientation="horizontal"
                android:padding="16dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/featureSafeQr">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_badge_green"
                    android:padding="8dp"
                    android:src="@drawable/ic_customers"
                    app:tint="@color/primary"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Unified Family Health Circle"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Manage health profiles for parents, spouse, and children with absolute SQLite database isolation between records."
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Bottom spacing -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@id/featureFamily"/>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
